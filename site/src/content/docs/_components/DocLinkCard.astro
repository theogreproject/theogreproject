---
import { LinkCard } from '@astrojs/starlight/components';

const { href = '', ...rest } = Astro.props;

const rawHref = String(href);
const isExternal = /^(https?:|mailto:|tel:|#)/.test(rawHref);

const base = import.meta.env.BASE_URL ?? '/';
const normalizedBase = base.endsWith('/') ? base : `${base}/`;

const pathWithoutBase = Astro.url.pathname.startsWith(normalizedBase)
  ? Astro.url.pathname.slice(normalizedBase.length)
  : Astro.url.pathname.replace(/^\/+/, '');

const localeMatch = pathWithoutBase.match(/^([a-z]{2}-[a-z]{2})\//);
const currentLocale = localeMatch ? localeMatch[1] : '';

let finalHref = rawHref;

if (!isExternal) {
  let slug = rawHref.replace(/^\/+/, '');
  const hasLocalePrefix = Boolean(slug.match(/^[a-z]{2}-[a-z]{2}\//));
  const localePrefix = hasLocalePrefix || !currentLocale ? '' : `${currentLocale}/`;

  finalHref = `${normalizedBase}${localePrefix}${slug}`.replace(/\/{2,}/g, '/');

  if (!finalHref.endsWith('/') && !/[?#]/.test(finalHref)) {
    finalHref += '/';
  }
}
---

<LinkCard href={finalHref} {...rest} />
